* text=auto

*.png binary
*.jpg binary
*.mp4 binary

# These are copied straight to the Linux server and executed there. Checked out
# with CRLF on Windows, bash fails on the first line with $'\r': command not
# found, so they are pinned to LF regardless of the machine holding the clone.
*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
